rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{boardId} {
        // Allow read if public or owner
      allow read: if resource.data.isPublic == true || resource.data.ownerId == request.auth.uid;
      // Allow write only if owner (or initial create)
      allow create: if request.auth != null;
      allow update: if resource.data.ownerId == request.auth.uid;
      allow delete: if resource.data.ownerId == request.auth.uid;
    }
  }
}
